pkgname=label-maker
pkgver=0.1.0
pkgrel=1
pkgdesc='Print labels and stickers on the D450'
arch=('x86_64' 'aarch64')
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'qt6-wayland' 'qt6-imageformats' 'poppler-qt6' 'xdg-desktop-portal')
makedepends=('gcc' 'make' 'pkgconf')
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  install -Dm755 build/label-maker "$pkgdir/usr/bin/label-maker"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$startdir/label-maker.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/label-maker.svg"
  install -Dm644 "$startdir/label-maker.desktop" "$pkgdir/usr/share/applications/label-maker.desktop"
}
